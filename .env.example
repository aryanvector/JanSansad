# AI synthesis provider: gemini or openai (auto prefers a Gemini key when present)
AI_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
# Optional OpenAI provider
# Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# -- Qdrant --
# QDRANT_HOST=localhost
# QDRANT_PORT=6333
# QDRANT_COLLECTION=lok_sabha_questions

# -- HuggingFace RAG data (pre-built snapshot + metadata) --
# HF_RAG_DATA_REPO=opensansad/lok-sabha-rag-data

# -- Data paths --
# DATA_DIR=data
# METADATA_DB_PATH=data/metadata.db

# -- Embedding model --
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# -- Debug --
# RAG_LOG_CHUNKS=1
